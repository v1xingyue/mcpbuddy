# GitHub OAuth App (callback: http://localhost:3000/api/auth/callback/github)
AUTH_SECRET=generate-a-32-byte-secret
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth Client (callback: http://localhost:3000/api/auth/callback/google)
# Create a Web application client in Google Cloud Console.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Vercel Postgres (injected automatically after connecting the integration)
POSTGRES_URL=

# Private Vercel Blob (required in production for OAuth token replay protection)
BLOB_READ_WRITE_TOKEN=

# MCP OAuth signing key; use a different high-entropy value from AUTH_SECRET
OAUTH_SECRET=generate-a-second-32-byte-secret
MCP_RESOURCE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
